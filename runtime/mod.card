return {
  summary = "Explore HnS with source music, restored ambient Pokémon, stairs and healing presentation, complete ELM’s errand, explore SPROUT TOWER and challenge FALKNER for the ZEPHYR BADGE and TM51 ROOST. Later campaign progression is still being ported.",
  author = "TheEelYT / Codex port",
  tags = { "hns", "johto", "prototype" },
  differences = {
    added = { "Sealed GitHub cart download with isolated saves and exact ZIP SHA-256", "Complete source egg/level-up/TM/HM/tutor Dex browsing: Totodile 87 moves", "Animated stats icons, unseen question portraits, red scroll arrows and source move item icons", "Pokégear grey footer, centered help and selected-button brightness pulse", "PC-only PREVIOUS/NEXT/SAVE and CANCEL header", "Restored native Gen1Recomp settings in a dedicated tab with original actions and persistence", "Loaded-game final settings page ignores R", "Source Dex/Map/Call layering, fonts, glyphs and complete scrolling cursor", "Visible source Gold/Kris exit arrows from the horizontal frame sheet", "Native capture-to-nickname handoff repair", "HGSS Plus list, details, statistics, ability and complete source move information", "Common HnS save/Continue/card/dex counts and full Elm phone ratings", "Source phone list window/text palette", "Source Pokégear service layouts, condition graph and earned ribbons", "69 animated tileset pairs with source callback schedules and all three layers", "Sliding START hint, source capture jingles and HGSS Plus registration", "HnS trainer card palettes, portraits, badges and saved party", "Fixed HnS move data/type chart/critical odds, Hidden Power, Explosion and Facade rules", "Nine active source settings for categories, Fairy, Sturdy, Sitrus, poison, EXP, EVs and battle items", "Egg handoff jingle, Mom farewell gate and Oak intro after EXIT", "Source menu fonts, dependency greying, confirmation and PC Game Modes with source mid-run locks", "Oak’s source Wooper release and red challenge disclaimer", "Starter preview/cry, optional real nicknames and nickname saves", "Source Elm email pause/emote, Silver shove and full Cherrygrove guide tour", "Source ringing/call/namebox/hang-up and startup help window", "560 HnS maps and four shared rooms with native layers, collision, connections and warps", "505 original signs; 495 dialogue NPCs with source movement; 28 healing nurses", "22 basic mart clerks with source inventories through the native shop", "Mom, Elm, two aides and Mom's friend with HnS graphics", "Three level-5 Johto starter choices, persistent choice flags and lab healing", "316 supported source wild pools across 150 maps; native capture into party or PC", "Mr. Pokémon’s egg, Oak’s dex, Silver’s battle and Elm delivery with persistent one-time aide gifts", "227 ordinary source trainer battles with portraits, sight, persistent defeat flags and prize money", "Source Elm/email, Mr. Pokémon/Oak and officer/rival-name scenes", "HnS Johto Pokédex with 282 source numbers, native seen/caught and entry/stat pages", "23 additional residents including New Bark's man/Wooper and Route 30's CHERI BERRY gift", "148 source map, encounter, battle/victory, intro and radio songs and jingles", "Oak startup, all nine source settings pages, bed spawn, clock help and Mom’s Pokégear/running shoes", "Source town/route banner artwork and Gold/Kris field and battle sprites", "Automatic one-time aide gifts and live officer name confirmation", "Elm’s exit interruption and manual directions/phone registration; town blocker, window Silver and Route 29 grass man", "Pokégear Johto/Kanto map, Mom/Elm phone and incoming errand call, clock, condition/ribbons and quiz-gated radio", "Key-item EXP. SHARE toggle with source party experience ratios and Center clock resetting", "1368 additional field Pokémon with source art/movement and 104 cry/dialogue interactions", "Source sideways overworld stairs, receipt jingles and Center/black-fade healing", "Sprout Tower Silver/Li/Flash and four source pickups", "Falkner, Zephyr Badge, gym guide/statues and usable TM51 Roost" },
    changed = { "Connected-map HnS sprites stay visible and legacy scene positions use native operands", "NPC sprite manifests reload with all HnS sheets and preserved Emerald avatars", "HnS graphics resolve across mounted cache roots; native atlas state is refreshed", "Map-entry binding preserves the opening quest triggers", "New Game enters New Bark Town in a newly created save slot" },
    known = { "Retains Emerald title and naming keyboard; source Oak/Wooper/Gold/Kris art, speech backdrop, music and field/battle avatars", "All source settings pages save choices; unfinished effects are labeled pending", "Core Pokégear and opening calls work; later contacts/rematches, radio rewards/encounter effects and followers remain in progress", "GB SOUNDS is present; alternate GB playback remains unported", "Emerald base stats/effects plus source move parameters/chart/critical and nine HnS setting effects; expanded abilities/moves/learnsets remain pending; unsupported teams/pools are audited", "Later Gyms/story, scripted travel, puzzles, expanded-item shops, exchanges, rematches and remaining conditional NPCs are unported; unused source warps remain inert", "Requires engine_internals and the tested engine revision; restart after updating" },
  },
  credits = {
    { who = "Pokémon Heart and Soul / PokemonHnS-Development", for_ = "v2.0.6 source, maps, graphics and dialogue; https://github.com/PokemonHnS-Development/pokehns-expansion" },
    { who = "RHH / rh-hideout", for_ = "pokeemerald-expansion base; upstream HnS credits identify version 1.15.1" },
    { who = "resetes12", for_ = "Modern Emerald base" },
    { who = "pret and the original Pokémon developers", for_ = "Emerald/FRLG decompilation and underlying game data" },
    { who = "BOIS CLUB GAMES, LLC / Gen1Recomp contributors", for_ = "Based on the Pokemon Gen 1 Recompilation Project by BOIS CLUB GAMES, LLC (https://github.com/bryanthaboi/gen1recomp)" },
  },
  compat = { engine = ">=0.0.0-0 <1.0.0", modApi = 2 },
}
